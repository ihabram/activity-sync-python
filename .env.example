# Strava API Credentials (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REFRESH_TOKEN=your_strava_refresh_token
STRAVA_VERIFY_TOKEN=create_a_random_secret_token_for_webhook_handshake

# Garmin Connect Credentials
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
# Path where Garmin session tokens are saved (defaults to ~/.garminconnect)
GARMIN_TOKENSTORE_DIR=/home/pi/.garminconnect

# Security / Deployment
DEPLOY_SECRET=create_a_random_secret_token_for_github_deploy
PORT=8000
